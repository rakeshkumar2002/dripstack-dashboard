# ─── CROSS-REPO CONTRACT (see CONTRACT.md) ───────────────────────────────────
# DASHBOARD_API_URL must equal APP_BASE_URL in dripstack-backend.
#
# Read at REQUEST time by app/layout.tsx and injected as
# window.__DRIPSTACK_CONFIG__, so one Docker image serves every environment.
# The container refuses to start in production if this is unset.
DASHBOARD_API_URL=http://localhost:4000

# Build-time fallback only. Next inlines NEXT_PUBLIC_* at COMPILE time, so
# changing this requires a rebuild. Leave at the localhost default unless you
# deliberately want an environment-specific image.
NEXT_PUBLIC_API_URL=http://localhost:4000

# This app's own public origin must be set as DASHBOARD_URL in dripstack-backend,
# exactly and with no trailing slash, or every request fails CORS preflight.
PORT=3000
